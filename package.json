{
  "name": "datanexus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:all": "concurrently --kill-others-on-fail \"tauri dev\" \"cd backend && python -m uvicorn main:app --reload\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "cd backend && venv\\Scripts\\python.exe -m pytest",
    "test:backend": "cd backend && venv\\Scripts\\python.exe -m pytest -v",
    "test:quick": "cd backend && venv\\Scripts\\python.exe -m pytest -x -q",
    "build:backend": "powershell -ExecutionPolicy Bypass -File backend/build_backend.ps1",
    "build:all": "pnpm run build:backend && pnpm tauri build"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "axios": "^1.13.5",
    "lucide-react": "^0.576.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
